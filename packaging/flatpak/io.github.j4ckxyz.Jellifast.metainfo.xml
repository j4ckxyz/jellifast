<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.j4ckxyz.Jellifast</id>
  <name>Jellifast</name>
  <summary>A native music player for Jellyfin</summary>
  <developer id="io.github.j4ckxyz">
    <name>j4ckxyz</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      A music player for Jellyfin written in Rust with no browser engine. It
      starts in well under a second, plays your server's music on this
      computer, and controls other Jellyfin players.
    </p>
    <p>
      Browse your library, search it, edit playlists, manage the queue, and
      view lyrics. It also has keyboard shortcuts, media-key support,
      background playback, and a mini player for classic Winamp skins.
    </p>
  </description>
  <launchable type="desktop-id">io.github.j4ckxyz.Jellifast.desktop</launchable>
  <url type="homepage">https://github.com/j4ckxyz/jellifast</url>
  <url type="bugtracker">https://github.com/j4ckxyz/jellifast/issues</url>
  <url type="help">https://github.com/j4ckxyz/jellifast/blob/main/docs/_guide/getting-started.md</url>
  <url type="vcs-browser">https://github.com/j4ckxyz/jellifast</url>
  <branding>
    <color type="primary" scheme_preference="light">#1ed760</color>
    <color type="primary" scheme_preference="dark">#144a2a</color>
  </branding>
  <content_rating type="oars-1.1" />
  <requires>
    <display_length compare="ge">760</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <releases>
    <release version="0.1.0" date="2026-10-04">
      <url>https://github.com/j4ckxyz/jellifast/releases/tag/v0.1.0</url>
    </release>
  </releases>
</component>
